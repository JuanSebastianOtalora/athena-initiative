# ─────────────────────────────────────────────────────────────
#  Athena — Open Notebook  (per-service secrets)
#  Copy to `.env` before first start. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# Host ports (overridable)
NOTEBOOK_PORT=8502
NOTEBOOK_API_PORT=5055

# Encryption key for local data — REQUIRED
OPEN_NOTEBOOK_ENCRYPTION_KEY=   # generate: openssl rand -hex 32

# ── SurrealDB knowledge graph — REQUIRED (Open Notebook depends on it) ─────
SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=              # REQUIRED — must match databases/surrealdb/.env
                               # (athena-up.sh generates it into both)

# ── Optional: AI / embeddings provider ─────────────────────────────────────
# Athena is not AI-first — plug in an LLM/embedding backend only if you want
# semantic search or LLM assistance. Run it here, or point Open Notebook at
# an inference service running elsewhere.
# OPENAI_API_KEY=
# EMBEDDINGS_PROVIDER=openai
