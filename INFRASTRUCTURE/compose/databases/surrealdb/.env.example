# ─────────────────────────────────────────────────────────────
#  Athena — SurrealDB  (per-service secrets)
#  Copy to `.env` before first start. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# Credentials
SURREAL_USER=root
SURREAL_PASSWORD=            # REQUIRED — shared with Open Notebook; athena-up.sh
                             # generates it into both .env files

# Database name (mounted at /mydata/<name>)
SURREAL_DB=athena

# Optional feature flags
SURREAL_EXPERIMENTAL_GRAPHQL=true
