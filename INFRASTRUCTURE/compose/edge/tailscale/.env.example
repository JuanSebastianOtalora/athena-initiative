# ─────────────────────────────────────────────────────────────
#  Athena — Tailscale  (per-service config)
#  Copy to `.env` before first start. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# Headless auth key (tskey-...) for automatic tailnet join.
# Leave empty to authorize interactively via `ts login`.
TAILSCALE_AUTHKEY=

# Optional: extra tailscale up args (e.g. --advertise-tags=tag<location>)
TAILSCALE_ARGS=--advertise-tags=
