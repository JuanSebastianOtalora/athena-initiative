# ─────────────────────────────────────────────────────────────
#  Athena — Caddy  (per-service config)
#  Copy to `.env` before first start. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# Host ports
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Optional: a real domain for automatic HTTPS (leave empty for LAN / tailnet)
# CADDY_DOMAIN=
